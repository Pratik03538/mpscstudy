# Copy your existing Telegram bot settings into /etc/mpsc-study.env.
# Never commit the real token or real IDs to GitHub.

TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE

# Absolute paths on the Oracle VM (do not use relative paths here).
BOT_DB_PATH=/opt/mpscstudy/telegram_bot/database/mpsc_subject_only.db
BOT_STATE_DB_PATH=/var/lib/mpsc-study/bot_progress.sqlite3

PUBLIC_CHANNEL_ID=@your_public_channel
PUBLIC_CHANNEL_LINK=https://t.me/your_public_channel
DISCUSSION_GROUP_ID=-1001234567890
DISCUSSION_GROUP_LINK=https://t.me/your_discussion_group
ADMIN_USER_IDS=123456789

EVENT_HOUR=20
EVENT_MINUTE=30
EVENT_QUESTION_COUNT=15
EVENT_QUESTION_SECONDS=35

OPEN_CHALLENGE_TTL=600
START_CONFIRM_TTL=120

# Fill these after domain DNS and BotFather Mini App configuration.
MINI_APP_URL=
MINI_APP_SHORT_NAME=
MINI_APP_AUTH_MAX_AGE=86400
