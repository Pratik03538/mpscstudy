# BotFather token. Never share this value or commit your real .env.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# SQLite source and separate user/event state database.
BOT_DB_PATH=database/mpsc_subject_only.db
BOT_STATE_DB_PATH=data/bot_progress.sqlite3

# Telegram destinations. Use @publicusername or numeric chat ID (-100...).
PUBLIC_CHANNEL_ID=@your_public_channel
PUBLIC_CHANNEL_LINK=https://t.me/your_public_channel
DISCUSSION_GROUP_ID=-1001234567890
DISCUSSION_GROUP_LINK=https://t.me/your_discussion_group

# Comma-separated Telegram numeric user IDs allowed to run /event_now and /event_stop.
ADMIN_USER_IDS=123456789

# Daily automatic official channel event, India time (Asia/Kolkata).
EVENT_HOUR=20
EVENT_MINUTE=30
EVENT_QUESTION_COUNT=15
EVENT_QUESTION_SECONDS=35

# Public PvP battles: fixed 10 questions / 10-minute match timer.
OPEN_CHALLENGE_TTL=600
START_CONFIRM_TTL=120

# Telegram Mini App: set only after deploying the app to HTTPS and creating it in BotFather.
MINI_APP_URL=
MINI_APP_SHORT_NAME=

MINI_APP_AUTH_MAX_AGE=86400
